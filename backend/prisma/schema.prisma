generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                   String                   @unique
  passwordHash            String?                  @map("password_hash")
  displayName             String?                  @map("display_name")
  appleSubject            String?                  @unique @map("apple_subject")
  googleSubject           String?                  @unique @map("google_subject")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  sessions                AuthSession[]
  subscriptionEntitlement SubscriptionEntitlement?
  appStoreTransactions    AppStoreTransaction[]
  pushTokens              PushToken[]
  pushNotificationOutbox  PushNotificationOutbox[]
  pushDeliveries          PushDelivery[]
  staffProfile            StaffProfile?

  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

enum SubscriptionPlatform {
  ios

  @@map("subscription_platform")
}

enum SubscriptionState {
  inactive
  pending
  active
  billing_grace_period
  billing_retry
  expired
  revoked

  @@map("subscription_state")
}

model SubscriptionEntitlement {
  id                    String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String                @unique @map("user_id") @db.Uuid
  entitlementKey        String                @default("premium") @map("entitlement_key")
  platform              SubscriptionPlatform?
  state                 SubscriptionState     @default(inactive)
  productId             String?               @map("product_id")
  originalTransactionId String?               @unique @map("original_transaction_id")
  transactionId         String?               @map("transaction_id")
  webOrderLineItemId    String?               @map("web_order_line_item_id")
  expiresAt             DateTime?             @map("expires_at")
  willAutoRenew         Boolean?              @map("will_auto_renew")
  environment           String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "subscription_entitlements_user_id_fkey")

  @@index([state], map: "subscription_entitlements_state_idx")
  @@index([expiresAt], map: "subscription_entitlements_expires_at_idx")
  @@map("subscription_entitlements")
}

model AppStoreTransaction {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  originalTransactionId String            @map("original_transaction_id")
  transactionId         String            @unique @map("transaction_id")
  webOrderLineItemId    String?           @map("web_order_line_item_id")
  productId             String            @map("product_id")
  state                 SubscriptionState
  environment           String?
  appAccountToken       String?           @map("app_account_token")
  purchaseDate          DateTime?         @map("purchase_date")
  expiresAt             DateTime?         @map("expires_at")
  revokedAt             DateTime?         @map("revoked_at")
  willAutoRenew         Boolean?          @map("will_auto_renew")
  signedTransactionHash String            @unique @map("signed_transaction_hash")
  signedRenewalHash     String?           @map("signed_renewal_hash")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "app_store_transactions_user_id_fkey")

  @@index([userId], map: "app_store_transactions_user_id_idx")
  @@index([originalTransactionId], map: "app_store_transactions_original_transaction_id_idx")
  @@index([state], map: "app_store_transactions_state_idx")
  @@map("app_store_transactions")
}

model AppStoreWebhook {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationUuid      String?   @unique @map("notification_uuid")
  signedPayloadHash     String    @unique @map("signed_payload_hash")
  notificationType      String?   @map("notification_type")
  subtype               String?
  environment           String?
  originalTransactionId String?   @map("original_transaction_id")
  transactionId         String?   @map("transaction_id")
  processedAt           DateTime? @map("processed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([originalTransactionId], map: "app_store_webhooks_original_transaction_id_idx")
  @@index([processedAt], map: "app_store_webhooks_processed_at_idx")
  @@map("app_store_webhooks")
}

enum PushTokenPlatform {
  android
  ios

  @@map("push_token_platform")
}

enum PushNotificationOutboxStatus {
  pending
  processing
  sent
  failed
  skipped

  @@map("push_notification_outbox_status")
}

enum PushDeliveryStatus {
  pending
  sent
  delivered
  failed
  skipped

  @@map("push_delivery_status")
}

model PushToken {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  expoPushToken String             @unique @map("expo_push_token")
  platform      PushTokenPlatform?
  deviceId      String?            @map("device_id")
  disabledAt    DateTime?          @map("disabled_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "push_tokens_user_id_fkey")

  @@index([userId, disabledAt], map: "push_tokens_user_id_disabled_at_idx")
  @@map("push_tokens")
}

model PushNotificationOutbox {
  id           String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String                       @map("user_id") @db.Uuid
  dedupeKey    String                       @map("dedupe_key")
  title        String
  body         String
  data         Json?
  status       PushNotificationOutboxStatus @default(pending)
  scheduledFor DateTime                     @default(now()) @map("scheduled_for")
  attempts     Int                          @default(0)
  lastError    String?                      @map("last_error")
  processedAt  DateTime?                    @map("processed_at")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "push_notification_outbox_user_id_fkey")
  deliveries   PushDelivery[]

  @@unique([userId, dedupeKey], map: "push_notification_outbox_user_id_dedupe_key_key")
  @@index([status, scheduledFor], map: "push_notification_outbox_status_scheduled_for_idx")
  @@index([userId], map: "push_notification_outbox_user_id_idx")
  @@map("push_notification_outbox")
}

model PushDelivery {
  id                   String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  outboxId             String                 @map("outbox_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  pushTokenId          String?                @map("push_token_id") @db.Uuid
  expoPushToken        String?                @map("expo_push_token")
  status               PushDeliveryStatus     @default(pending)
  ticketId             String?                @map("ticket_id")
  providerStatus       String?                @map("provider_status")
  providerErrorCode    String?                @map("provider_error_code")
  errorMessage         String?                @map("error_message")
  receiptCheckAttempts Int                    @default(0) @map("receipt_check_attempts")
  receiptNextCheckAt   DateTime?              @map("receipt_next_check_at")
  receiptCheckedAt     DateTime?              @map("receipt_checked_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  outbox               PushNotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade, map: "push_deliveries_outbox_id_fkey")
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "push_deliveries_user_id_fkey")

  @@unique([outboxId, pushTokenId], map: "push_deliveries_outbox_id_push_token_id_key")
  @@index([ticketId, status], map: "push_deliveries_ticket_id_status_idx")
  @@index([status, receiptNextCheckAt], map: "push_deliveries_status_receipt_next_check_at_idx")
  @@index([userId, createdAt], map: "push_deliveries_user_id_created_at_idx")
  @@map("push_deliveries")
}

enum StaffRole {
  MECHANIC
  MASTER
  DIRECTOR
  ADMIN

  @@map("staff_role")
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  COMPLETED
  CLOSED
  CANCELLED

  @@map("work_order_status")
}

enum RecommendationStatus {
  SUGGESTED
  APPROVED
  DECLINED
  DONE

  @@map("recommendation_status")
}

enum AttachmentType {
  PHOTO
  DOCUMENT
  VIDEO

  @@map("attachment_type")
}

enum AttachmentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE

  @@map("attachment_visibility")
}

model Organization {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  slug           String                   @unique
  timezone       String                   @default("Europe/Moscow")
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  serviceCenters ServiceCenter[]
  staffProfiles  StaffProfile[]
  customers      Customer[]
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
  statusHistory  WorkOrderStatusHistory[]
  inspectionActs InspectionAct[]
  diagnostics    Diagnostic[]
  recommendations Recommendation[]
  attachments    OrderAttachment[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model ServiceCenter {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "service_centers_organization_id_fkey")
  staffProfiles  StaffProfile[]
  workOrders     WorkOrder[]

  @@index([organizationId], map: "service_centers_organization_id_idx")
  @@index([organizationId, name], map: "service_centers_organization_id_name_idx")
  @@map("service_centers")
}

model StaffProfile {
  id                         String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                     String                   @unique @map("user_id") @db.Uuid
  organizationId             String                   @map("organization_id") @db.Uuid
  serviceCenterId            String?                  @map("service_center_id") @db.Uuid
  fullName                   String?                  @map("full_name")
  phone                      String?
  role                       StaffRole
  isActive                   Boolean                  @default(true) @map("is_active")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "staff_profiles_user_id_fkey")
  organization               Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "staff_profiles_organization_id_fkey")
  serviceCenter              ServiceCenter?           @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull, map: "staff_profiles_service_center_id_fkey")
  createdWorkOrders          WorkOrder[]              @relation("WorkOrderCreatedBy")
  responsibleWorkOrders      WorkOrder[]              @relation("WorkOrderResponsible")
  statusChanges              WorkOrderStatusHistory[]
  inspectionActsCreated      InspectionAct[]          @relation("InspectionActCreatedBy")
  inspectionActsUpdated      InspectionAct[]          @relation("InspectionActUpdatedBy")
  diagnosticsCreated         Diagnostic[]             @relation("DiagnosticCreatedBy")
  diagnosticsUpdated         Diagnostic[]             @relation("DiagnosticUpdatedBy")
  diagnosticsExecuted        Diagnostic[]             @relation("DiagnosticExecutor")
  recommendationsCreated     Recommendation[]         @relation("RecommendationCreatedBy")
  recommendationsUpdated     Recommendation[]         @relation("RecommendationUpdatedBy")
  attachmentsCreated         OrderAttachment[]        @relation("OrderAttachmentCreatedBy")
  auditLogs                  AuditLog[]

  @@index([organizationId, role], map: "staff_profiles_organization_id_role_idx")
  @@index([serviceCenterId], map: "staff_profiles_service_center_id_idx")
  @@map("staff_profiles")
}

model Customer {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String?
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "customers_organization_id_fkey")
  vehicles       Vehicle[]
  workOrders     WorkOrder[]

  @@index([organizationId, phone], map: "customers_organization_id_phone_idx")
  @@index([organizationId, name], map: "customers_organization_id_name_idx")
  @@map("customers")
}

model Vehicle {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  brand          String?
  model          String?
  brandModel     String        @map("brand_model")
  vin            String?
  plate          String?
  engineSpec     String?       @map("engine_spec")
  year           Int?
  currentMileage Int?          @map("current_mileage")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "vehicles_organization_id_fkey")
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "vehicles_customer_id_fkey")
  workOrders     WorkOrder[]

  @@index([organizationId, vin], map: "vehicles_organization_id_vin_idx")
  @@index([organizationId, plate], map: "vehicles_organization_id_plate_idx")
  @@index([customerId], map: "vehicles_customer_id_idx")
  @@map("vehicles")
}

model WorkOrder {
  id                        String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  serviceCenterId           String?                  @map("service_center_id") @db.Uuid
  customerId                String?                  @map("customer_id") @db.Uuid
  vehicleId                 String                   @map("vehicle_id") @db.Uuid
  number                    String
  status                    WorkOrderStatus          @default(OPEN)
  visitReason               String?                  @map("visit_reason")
  mileage                   Int?
  responsibleStaffProfileId String?                  @map("responsible_staff_profile_id") @db.Uuid
  createdByStaffProfileId   String                   @map("created_by_staff_profile_id") @db.Uuid
  closedAt                  DateTime?                @map("closed_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "work_orders_organization_id_fkey")
  serviceCenter             ServiceCenter?           @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull, map: "work_orders_service_center_id_fkey")
  customer                  Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "work_orders_customer_id_fkey")
  vehicle                   Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, map: "work_orders_vehicle_id_fkey")
  responsibleStaffProfile   StaffProfile?            @relation("WorkOrderResponsible", fields: [responsibleStaffProfileId], references: [id], onDelete: SetNull, map: "work_orders_responsible_staff_profile_id_fkey")
  createdByStaffProfile     StaffProfile             @relation("WorkOrderCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: Restrict, map: "work_orders_created_by_staff_profile_id_fkey")
  statusHistory             WorkOrderStatusHistory[]
  inspectionAct             InspectionAct?
  diagnostics               Diagnostic[]
  recommendations           Recommendation[]
  attachments               OrderAttachment[]

  @@unique([organizationId, number], map: "work_orders_organization_id_number_key")
  @@index([organizationId, status], map: "work_orders_organization_id_status_idx")
  @@index([organizationId, createdAt], map: "work_orders_organization_id_created_at_idx")
  @@index([serviceCenterId, status], map: "work_orders_service_center_id_status_idx")
  @@index([customerId], map: "work_orders_customer_id_idx")
  @@index([vehicleId], map: "work_orders_vehicle_id_idx")
  @@index([responsibleStaffProfileId], map: "work_orders_responsible_staff_profile_id_idx")
  @@map("work_orders")
}

model WorkOrderStatusHistory {
  id                      String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId          String          @map("organization_id") @db.Uuid
  workOrderId             String          @map("work_order_id") @db.Uuid
  fromStatus              WorkOrderStatus? @map("from_status")
  toStatus                WorkOrderStatus @map("to_status")
  comment                 String?
  changedByStaffProfileId String          @map("changed_by_staff_profile_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at")
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "work_order_status_history_organization_id_fkey")
  workOrder               WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade, map: "work_order_status_history_work_order_id_fkey")
  changedByStaffProfile   StaffProfile    @relation(fields: [changedByStaffProfileId], references: [id], onDelete: Restrict, map: "work_order_status_history_changed_by_staff_profile_id_fkey")

  @@index([organizationId, createdAt], map: "work_order_status_history_organization_id_created_at_idx")
  @@index([workOrderId, createdAt], map: "work_order_status_history_work_order_id_created_at_idx")
  @@index([changedByStaffProfileId], map: "work_order_status_history_changed_by_staff_profile_id_idx")
  @@map("work_order_status_history")
}

model InspectionAct {
  id                       String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  workOrderId              String            @unique @map("work_order_id") @db.Uuid
  dataJson                 Json              @map("data_json")
  schemaVersion            Int               @default(1) @map("schema_version")
  completedAt              DateTime?         @map("completed_at")
  createdByStaffProfileId  String            @map("created_by_staff_profile_id") @db.Uuid
  updatedByStaffProfileId  String?           @map("updated_by_staff_profile_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "inspection_acts_organization_id_fkey")
  workOrder                WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade, map: "inspection_acts_work_order_id_fkey")
  createdByStaffProfile    StaffProfile      @relation("InspectionActCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: Restrict, map: "inspection_acts_created_by_staff_profile_id_fkey")
  updatedByStaffProfile    StaffProfile?     @relation("InspectionActUpdatedBy", fields: [updatedByStaffProfileId], references: [id], onDelete: SetNull, map: "inspection_acts_updated_by_staff_profile_id_fkey")
  recommendations          Recommendation[]
  attachments              OrderAttachment[]

  @@index([organizationId, createdAt], map: "inspection_acts_organization_id_created_at_idx")
  @@index([createdByStaffProfileId], map: "inspection_acts_created_by_staff_profile_id_idx")
  @@map("inspection_acts")
}

model Diagnostic {
  id                       String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  workOrderId              String            @map("work_order_id") @db.Uuid
  dataJson                 Json              @map("data_json")
  schemaVersion            Int               @default(1) @map("schema_version")
  otherRecommendations     String?           @map("other_recommendations")
  alignmentComment         String?           @map("alignment_comment")
  partsTotal               Decimal?          @map("parts_total") @db.Decimal(12, 2)
  serviceTotal             Decimal?          @map("service_total") @db.Decimal(12, 2)
  grandTotal               Decimal?          @map("grand_total") @db.Decimal(12, 2)
  executorStaffProfileId   String?           @map("executor_staff_profile_id") @db.Uuid
  createdByStaffProfileId  String            @map("created_by_staff_profile_id") @db.Uuid
  updatedByStaffProfileId  String?           @map("updated_by_staff_profile_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "diagnostics_organization_id_fkey")
  workOrder                WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade, map: "diagnostics_work_order_id_fkey")
  executorStaffProfile     StaffProfile?     @relation("DiagnosticExecutor", fields: [executorStaffProfileId], references: [id], onDelete: SetNull, map: "diagnostics_executor_staff_profile_id_fkey")
  createdByStaffProfile    StaffProfile      @relation("DiagnosticCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: Restrict, map: "diagnostics_created_by_staff_profile_id_fkey")
  updatedByStaffProfile    StaffProfile?     @relation("DiagnosticUpdatedBy", fields: [updatedByStaffProfileId], references: [id], onDelete: SetNull, map: "diagnostics_updated_by_staff_profile_id_fkey")
  recommendations          Recommendation[]
  attachments              OrderAttachment[]

  @@index([organizationId, createdAt], map: "diagnostics_organization_id_created_at_idx")
  @@index([workOrderId, createdAt], map: "diagnostics_work_order_id_created_at_idx")
  @@index([executorStaffProfileId], map: "diagnostics_executor_staff_profile_id_idx")
  @@map("diagnostics")
}

model Recommendation {
  id                       String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId           String               @map("organization_id") @db.Uuid
  workOrderId              String               @map("work_order_id") @db.Uuid
  diagnosticId             String?              @map("diagnostic_id") @db.Uuid
  inspectionActId          String?              @map("inspection_act_id") @db.Uuid
  text                     String
  status                   RecommendationStatus @default(SUGGESTED)
  partsPrice               Decimal?             @map("parts_price") @db.Decimal(12, 2)
  servicePrice             Decimal?             @map("service_price") @db.Decimal(12, 2)
  totalPrice               Decimal?             @map("total_price") @db.Decimal(12, 2)
  createdByStaffProfileId  String               @map("created_by_staff_profile_id") @db.Uuid
  updatedByStaffProfileId  String?              @map("updated_by_staff_profile_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "recommendations_organization_id_fkey")
  workOrder                WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade, map: "recommendations_work_order_id_fkey")
  diagnostic               Diagnostic?          @relation(fields: [diagnosticId], references: [id], onDelete: SetNull, map: "recommendations_diagnostic_id_fkey")
  inspectionAct            InspectionAct?       @relation(fields: [inspectionActId], references: [id], onDelete: SetNull, map: "recommendations_inspection_act_id_fkey")
  createdByStaffProfile    StaffProfile         @relation("RecommendationCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: Restrict, map: "recommendations_created_by_staff_profile_id_fkey")
  updatedByStaffProfile    StaffProfile?        @relation("RecommendationUpdatedBy", fields: [updatedByStaffProfileId], references: [id], onDelete: SetNull, map: "recommendations_updated_by_staff_profile_id_fkey")
  attachments              OrderAttachment[]

  @@index([organizationId, status], map: "recommendations_organization_id_status_idx")
  @@index([workOrderId, status], map: "recommendations_work_order_id_status_idx")
  @@index([diagnosticId], map: "recommendations_diagnostic_id_idx")
  @@index([inspectionActId], map: "recommendations_inspection_act_id_idx")
  @@map("recommendations")
}

model OrderAttachment {
  id                      String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  workOrderId             String               @map("work_order_id") @db.Uuid
  inspectionActId         String?              @map("inspection_act_id") @db.Uuid
  diagnosticId            String?              @map("diagnostic_id") @db.Uuid
  recommendationId        String?              @map("recommendation_id") @db.Uuid
  type                    AttachmentType
  visibility              AttachmentVisibility @default(INTERNAL)
  storageKey              String               @map("storage_key")
  fileUrl                 String?              @map("file_url")
  originalFilename        String?              @map("original_filename")
  mimeType                String?              @map("mime_type")
  byteSize                Int?                 @map("byte_size")
  caption                 String?
  createdByStaffProfileId String               @map("created_by_staff_profile_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at")
  deletedAt               DateTime?            @map("deleted_at")
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "order_attachments_organization_id_fkey")
  workOrder               WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade, map: "order_attachments_work_order_id_fkey")
  inspectionAct           InspectionAct?       @relation(fields: [inspectionActId], references: [id], onDelete: SetNull, map: "order_attachments_inspection_act_id_fkey")
  diagnostic              Diagnostic?          @relation(fields: [diagnosticId], references: [id], onDelete: SetNull, map: "order_attachments_diagnostic_id_fkey")
  recommendation          Recommendation?      @relation(fields: [recommendationId], references: [id], onDelete: SetNull, map: "order_attachments_recommendation_id_fkey")
  createdByStaffProfile   StaffProfile         @relation("OrderAttachmentCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: Restrict, map: "order_attachments_created_by_staff_profile_id_fkey")

  @@index([organizationId, createdAt], map: "order_attachments_organization_id_created_at_idx")
  @@index([workOrderId, createdAt], map: "order_attachments_work_order_id_created_at_idx")
  @@index([inspectionActId], map: "order_attachments_inspection_act_id_idx")
  @@index([diagnosticId], map: "order_attachments_diagnostic_id_idx")
  @@index([recommendationId], map: "order_attachments_recommendation_id_idx")
  @@index([createdByStaffProfileId], map: "order_attachments_created_by_staff_profile_id_idx")
  @@map("order_attachments")
}

model AuditLog {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  staffProfileId String?       @map("staff_profile_id") @db.Uuid
  entityType     String        @map("entity_type")
  entityId       String        @map("entity_id")
  action         String
  payloadJson    Json?         @map("payload_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, map: "audit_logs_organization_id_fkey")
  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull, map: "audit_logs_staff_profile_id_fkey")

  @@index([organizationId, createdAt], map: "audit_logs_organization_id_created_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_type_entity_id_idx")
  @@index([staffProfileId, createdAt], map: "audit_logs_staff_profile_id_created_at_idx")
  @@map("audit_logs")
}
